#. odoo-python
#: code:addons/fleet_rental/wizard/account_payment_register.py:0
msgid ""
"<h3>First Payment Received!</h3><br/>Hi %s, <br/> This is to notify that "
"your first payment has been received. <br/><br/>Please find the details "
"below:<br/><br/><table><tr><td>Invoice Number<td/><td> "
"%s<td/><tr/><tr><td>Date<td/><td> %s <td/><tr/><tr><td>Amount <td/><td> "
"%s<td/><tr/><table/>"
msgstr "<h3>¡Primer pago recibido!</h3><br/>Hola %s, <br/> Te confirmamos que recibimos tu primer pago. <br/><br/>Estos son los detalles:<br/><br/><table><tr><td>Número de factura<td/><td> %s<td/><tr/><tr><td>Fecha<td/><td> %s <td/><tr/><tr><td>Importe <td/><td> %s<td/><tr/><table/>"

#. module: fleet_rental
#. odoo-python
#: code:addons/fleet_rental/models/car_rental_contract.py:0
msgid ""
"<h3>Order Confirmed!</h3><br/>Hi %s, <br/> This is to notify that your "
"rental contract has been confirmed. <br/><br/>Please find the details "
"below:<br/><br/><table><tr><td>Reference Number<td/><td> "
"%s<td/><tr/><tr><td>Time Range <td/><td> %s to %s <td/><tr/><tr><td>Vehicle "
"<td/><td> %s<td/><tr/><tr><td>Point Of Contact<td/><td> %s , "
"%s<td/><tr/><table/>"
msgstr "<h3>¡Contrato confirmado!</h3><br/>Hola %s, <br/> Te confirmamos que tu contrato de renta quedó confirmado. <br/><br/>Estos son los detalles:<br/><br/><table><tr><td>Número de referencia<td/><td> %s<td/><tr/><tr><td>Periodo <td/><td> %s a %s <td/><tr/><tr><td>Vehículo <td/><td> %s<td/><tr/><tr><td>Punto de contacto<td/><td> %s , %s<td/><tr/><table/>"

#. module: fleet_rental
#. odoo-python
#: code:addons/fleet_rental/models/car_rental_contract.py:0
msgid ""
"<h3>Reminder Recurrent Payment!</h3><br/>Hi %s, <br/> This is to remind you "
"that the recurrent payment for the rental contract has to be done.Please "
"make the payment at the earliest.<br/><br/>Please find the details "
"below:<br/><br/><table><tr><td>Contract Ref<td/><td> "
"%s<td/><tr/><tr/><tr><td>Amount <td/><td> %s<td/><tr/><tr/><tr><td>Due Date "
"<td/><td> %s<td/><tr/><tr/><tr><td>Responsible Person <td/><td> %s, "
"%s<td/><tr/><table/>"
msgstr "<h3>¡Recordatorio de pago recurrente!</h3><br/>Hola %s, <br/> Te recordamos que está pendiente el pago recurrente del contrato de renta. Agradecemos realizarlo a la brevedad.<br/><br/>Estos son los detalles:<br/><br/><table><tr><td>Referencia del contrato<td/><td> %s<td/><tr/><tr/><tr><td>Importe <td/><td> %s<td/><tr/><tr/><tr><td>Fecha de vencimiento <td/><td> %s<td/><tr/><tr/><tr><td>Responsable <td/><td> %s, %s<td/><tr/><table/>"

