#. odoo-python
#: code:addons/beflow_fleet_rental_fixes/models/car_rental_contract.py:0
msgid "Choose an end date later than %s."
msgstr "Elige una fecha de fin posterior al %s."

#. module: beflow_fleet_rental_fixes
#. odoo-python
#: code:addons/beflow_fleet_rental_fixes/models/car_rental_contract.py:0
msgid "The end date cannot be earlier than the start date."
msgstr "La fecha de fin no puede ser anterior a la de inicio."

