msgstr "Escribe las horas de inicio y fin como HH:MM, por ejemplo 08:30."

#. module: beflow_fleet_rental_fixes
#: model:ir.model.fields,field_description:beflow_fleet_rental_fixes.field_car_rental_contract__actual_return_date
msgid "Actual Return Date"
msgstr "Fecha real de devolución"

#. module: beflow_fleet_rental_fixes
#: model:ir.model.fields,help:beflow_fleet_rental_fixes.field_car_rental_contract__actual_return_date
msgid "Day the vehicle was checked in. The contracted end date is kept as agreed."
msgstr "Día en que se recibió el vehículo. La fecha de fin contratada se conserva tal como se acordó."

